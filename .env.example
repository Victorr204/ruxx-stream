# ── Supabase (free tier) ─────────────────────────────────────────────
# Project Settings → API. The anon key is safe to expose: every table is
# protected by Row Level Security (see supabase/migrations).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── App ──────────────────────────────────────────────────────────────
# Public web origin used for PWA manifest + auth redirects.
EXPO_PUBLIC_SITE_URL=http://localhost:8081

# ── Backblaze B2 — S3-compatible video storage ───────────────────────
# These are ONLY used by Supabase Edge Functions — never in the app.
# B2: no credit card needed, first 10GB free. Bucket: ruxx-stream.
# Set them with: supabase secrets set S3_ENDPOINT=... S3_REGION=... etc.
# S3_ENDPOINT=s3.eu-central-003.backblazeb2.com
# S3_REGION=eu-central-003
# S3_ACCESS_KEY_ID=your_application_key_id
# S3_SECRET_ACCESS_KEY=your_application_key
# S3_BUCKET=ruxx-stream

# ── Stripe (premium checkout) ────────────────────────────────────────
# Only used by the checkout + stripe-webhook edge functions. While unset,
# the app keeps its "Premium is coming soon" state.
# Set them with: supabase secrets set STRIPE_SECRET_KEY=... STRIPE_PRICE_ID=... etc.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=

# ── Ads (Google test IDs are seeded by default) ──────────────────────
EXPO_PUBLIC_ADMOB_ANDROID_TEST_UNIT_ID=ca-app-pub-3940256099942544/5224354917
EXPO_PUBLIC_ADMOB_IOS_TEST_UNIT_ID=ca-app-pub-3940256099942544/1712485313
