# ── Supabase (free tier) ─────────────────────────────────────────────
# Project Settings → API. The anon key is safe to expose: every table is
# protected by Row Level Security (see supabase/migrations).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── App ──────────────────────────────────────────────────────────────
# Public web origin used for PWA manifest + auth redirects.
EXPO_PUBLIC_SITE_URL=http://localhost:8081

# ── Backblaze B2 — S3-compatible video storage ───────────────────────
# These are ONLY used by Supabase Edge Functions — never in the app.
# B2: no credit card needed, first 10GB free. Bucket: ruxx-stream.
# Set them with: supabase secrets set S3_ENDPOINT=... S3_REGION=... etc.
# S3_ENDPOINT=s3.eu-central-003.backblazeb2.com
# S3_REGION=eu-central-003
# S3_ACCESS_KEY_ID=your_application_key_id
# S3_SECRET_ACCESS_KEY=your_application_key
# S3_BUCKET=ruxx-stream

# ── Paystack (premium checkout) ──────────────────────────────────────
# Only used by the checkout, paystack-verify and paystack-webhook edge
# functions. While unset, the app keeps its "Premium is coming soon" state.
# Set them with: supabase secrets set PAYSTACK_SECRET_KEY=... etc.
# PAYSTACK_SECRET_KEY=sk_test_or_sk_live_your_key
# PAYSTACK_PLAN_CODE=PLN_your_plan
# PAYSTACK_PLAN_AMOUNT=150000
# Payment page (preferred): checkout opens this link with the payer's
# email prefilled and locked, so the webhook can map the charge to an
# account. Trailing characters matter — copy the slug exactly.
# PAYSTACK_PAYMENT_PAGE=https://paystack.shop/pay_your_slug

# ── In-app stores (fill once the developer accounts exist) ───────────
# Phase 12 — Google Play Billing verification: base64 service-account JSON
# with the Android Publisher role.
# GOOGLE_SERVICE_ACCOUNT_B64=
# Phase 13 — App Store Server API (App Store Connect key + issuer).
# APPLE_ISSUER_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_B64=

# ── Ads ───────────────────────────────────────────────────────────────
# No ad env vars: unit IDs live in the DB (ad_units table), seeded with
# Google's official AdMob test IDs — swap in real IDs via Admin → Ads
# after development to avoid serving live ads from a dev build.
